# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shop
DB_USER=root
DB_PASS=root

# JWT (F01): chuỗi ngẫu nhiên dài tối thiểu 32 ký tự
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Frontend
FRONTEND_URL=http://localhost:5173

# Cloudinary (F05)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# VNPay sandbox (F09)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# Mail (F11)
MAIL_USER=
MAIL_PASS=
