# ========================
# Root mono-repo .gitignore
# ========================

### Secrets & environment ###
.env
*.env
!.env.example

### Agent ###
.agent/

### OS ###
.DS_Store
Thumbs.db

# ========================
# Backend (shop-backend/)
# ========================
shop-backend/HELP.md
shop-backend/target/
shop-backend/.mvn/wrapper/maven-wrapper.jar
!shop-backend/**/src/main/**/target/
!shop-backend/**/src/test/**/target/

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### VS Code ###
.vscode/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!shop-backend/**/src/main/**/build/
!shop-backend/**/src/test/**/build/

# ========================
# Frontend (shop-frontend/)
# ========================
shop-frontend/node_modules/
shop-frontend/.next/
shop-frontend/out/
shop-frontend/.env*.local
